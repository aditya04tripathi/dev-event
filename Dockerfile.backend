# Syntax=docker/dockerfile:1
FROM node:22-alpine AS base

# Install libc6-compat for compatibility with native modules
RUN apk add --no-cache libc6-compat
WORKDIR /app

# Pin pnpm version explicitly matching packageManager in package.json
RUN npm install -g pnpm@10.17.0

# --- Dependencies stage ---
FROM base AS deps
WORKDIR /app

# Install compilation toolchain for native modules (argon2, bcrypt) on alpine
RUN apk add --no-cache python3 make g++

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/
COPY backend/package.json ./backend/

RUN pnpm install --frozen-lockfile

# --- Builder stage ---
FROM base AS builder
WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY backend ./backend
COPY frontend/package.json ./frontend/package.json

ENV NODE_ENV=production

RUN pnpm --filter @dev-event/backend build
RUN pnpm prune --prod

# --- Production runner stage ---
FROM node:22-alpine AS runner
RUN apk add --no-cache libc6-compat
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# Create unprivileged user for security
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=nestjs:nodejs /app/backend/node_modules ./backend/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/backend/dist ./backend/dist
COPY --from=builder --chown=nestjs:nodejs /app/backend/package.json ./backend/package.json

USER nestjs
WORKDIR /app/backend

EXPOSE 3000

CMD ["node", "dist/main.js"]
