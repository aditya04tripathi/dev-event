# ==============================================================================
# DevEvent Monorepo - VPS Production Environment Variables
# ==============================================================================

# Application URLs
APP_PUBLIC_URL=https://devevent.adityatripathi.dev

# Host Port Allocation (Auto-managed by deploy.sh via /root/ports.csv)
APP_PORT=3000
BACKEND_PORT=3001

# Container Images (Pushed via GitHub Actions CI/CD to GHCR)
IMAGE_TAG=latest
FRONTEND_IMAGE=ghcr.io/aditya04tripathi/dev-event-frontend
BACKEND_IMAGE=ghcr.io/aditya04tripathi/dev-event-backend

# Runtime Environment
NODE_ENV=production
JWT_SECRET=your_jwt_secret_here

# MongoDB Database (Defaults to internal docker mongo service)
DATABASE_URL=mongodb://mongo:27017/dev-event

# MinIO Storage (Defaults to internal docker minio service)
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_URL=https://devevent.adityatripathi.dev/api/storage
MINIO_BUCKET_NAME=dev-event-bucket
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=password123
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123

# Internal Service Networking (Docker bridge network)
API_INTERNAL_URL=http://backend:3000
MINIO_INTERNAL_URL=http://minio:9000

# CORS Allowed Origins
CORS_ORIGINS=https://devevent.adityatripathi.dev,https://api.devevent.adityatripathi.dev
