{
  "name": "dev-event",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2",
      "bcrypt",
      "sharp",
      "unrs-resolver",
      "@nestjs/core"
    ]
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter @dev-event/frontend --filter @dev-event/backend run dev",
    "dev:frontend": "pnpm --filter @dev-event/frontend dev",
    "dev:backend": "pnpm --filter @dev-event/backend start:dev",
    "build": "pnpm -r --filter @dev-event/frontend --filter @dev-event/backend run build",
    "build:frontend": "pnpm --filter @dev-event/frontend build",
    "build:backend": "pnpm --filter @dev-event/backend build",
    "lint": "pnpm -r --filter @dev-event/frontend --filter @dev-event/backend run lint",
    "start:frontend": "pnpm --filter @dev-event/frontend start",
    "start:backend": "pnpm --filter @dev-event/backend start:prod"
  }
}
