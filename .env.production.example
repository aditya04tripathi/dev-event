# VPS production — copy to .env on the server.
# Cloudflare Tunnel (web only):
#   devevent.adityatripathi.dev -> http://127.0.0.1:49153
#
# API, MongoDB, and MinIO are internal to Docker; the browser only talks to the web app.

IMAGE_TAG=latest

APP_PUBLIC_URL=https://devevent.adityatripathi.dev

NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mongodb://mongodb:27017/dev-event

MINIO_ENDPOINT=minio
MINIO_PUBLIC_URL=https://devevent.adityatripathi.dev/api/storage
MINIO_BUCKET_NAME=dev-event-bucket
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-with-strong-password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-strong-password

CORS_ORIGINS=https://devevent.adityatripathi.dev
