# VPS production — copy to .env on the server.
# Cloudflare Tunnel routes (cloudflared on the same host):
#   devevent.adityatripathi.dev       -> http://127.0.0.1:49153
#   devevent-api.adityatripathi.dev   -> http://127.0.0.1:49152
#   devevent-minio.adityatripathi.dev -> http://127.0.0.1:49154
#
# GitHub Actions repository variables (baked into web image at build time):
#   NEXT_PUBLIC_API_URL=https://devevent-api.adityatripathi.dev
#   NEXT_PUBLIC_MINIO_PUBLIC_URL=https://devevent-minio.adityatripathi.dev

IMAGE_TAG=latest

NEXT_PUBLIC_API_URL=https://devevent-api.adityatripathi.dev
NEXT_PUBLIC_MINIO_PUBLIC_URL=https://devevent-minio.adityatripathi.dev

NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
DATABASE_URL=mongodb://mongodb:27017/dev-event

MINIO_ENDPOINT=minio
MINIO_PUBLIC_URL=https://devevent-minio.adityatripathi.dev
MINIO_BUCKET_NAME=dev-event-bucket
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=replace-with-strong-password
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=replace-with-strong-password

CORS_ORIGINS=https://devevent.adityatripathi.dev
